	public boolean isSendKeepAliveCommand()
	{
		return(mlngNextSendKeepAlive < System.currentTimeMillis());
	}

	public void sendKeepAlive() throws Exception
	{
		XMLMessage msgRequest = new XMLMessage();
		msgRequest.setValue("uinml.header.session",mstrSessionID);
		msgRequest.setValue("uinml.header.command",KEEPALIVE_COMMAND);
		msgRequest.store(socket.getOutputStream());
		socket.getOutputStream().flush();
		mlngNextSendKeepAlive = System.currentTimeMillis() + mintKeepAliveInterval;
		byte[] bt;
		synchronized(is){
			bt = com.fss.util.StreamUtil.getDataTerminatedBySymbol(is,TERMINATED_SYMBOL);
		}
	}

	public XMLMessage query(String strISDN) throws IOException,Exception
	{
		XMLMessage msgRequest = new XMLMessage();
		miTransID++;
		msgRequest.setValue("uinml.header.session",mstrSessionID);
		msgRequest.setValue("uinml.data.transid","" + miTransID);
		msgRequest.setValue("uinml.header.command",QUERY);
		msgRequest.setValue("uinml.data.msisdn",strISDN);

		OutputStream out = socket.getOutputStream();

		synchronized(out){
			msgRequest.store(out);
			out.flush();
		}
		byte[] bt;
		synchronized(is){
			bt = com.fss.util.StreamUtil.getDataTerminatedBySymbol(is,TERMINATED_SYMBOL);
		}
		mlngNextSendKeepAlive = System.currentTimeMillis() + mintKeepAliveInterval;
		int iIndex = 0;
		while(bt[iIndex] <= 32 && iIndex < bt.length){
			iIndex++;
		}
		try{
			XMLMessage msgResponse = new XMLMessage(new ByteArrayInputStream(bt,iIndex,bt.length - iIndex));
			return msgResponse;
		}
		catch(Exception ex){
			ex.printStackTrace();
			throw ex;
		}
	}

