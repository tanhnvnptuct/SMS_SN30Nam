	public void fillParameter(String strHost,int iPort,String strUserName,String strPassword,int iMintKeepAliveInterval) throws AppException
	{
		host = strHost;
		port = iPort;
		username = strUserName;
		password = strPassword;
		mintKeepAliveInterval = iMintKeepAliveInterval;

	}

	public void connect() throws Exception
	{
		socket = new Socket(host,port);
		XMLMessage msgRequest = new XMLMessage();
		msgRequest.setValue("uinml.header.session","0");
		msgRequest.setValue("uinml.header.command",CONNECT_COMMAND);
		msgRequest.setValue("uinml.data.username",username);
		msgRequest.setValue("uinml.data.password",password);
		msgRequest.store(socket.getOutputStream());
		socket.getOutputStream().flush();

		byte[] bt = com.fss.util.StreamUtil.getDataTerminatedBySymbol(socket.getInputStream(),TERMINATED_SYMBOL);
		XMLMessage msgResponse = new XMLMessage(new ByteArrayInputStream(bt));
		String strStatus = msgResponse.getValue("uinml.header.status");
		//logMonitor("Request is: " + msgRequest.toString());
		//logMonitor("Response is: " + msgResponse.getContent());
		if(strStatus == null || !strStatus.equals("0")){
			throw new Exception(msgResponse.getValue("uinml.data.errormessage"));
		}
		mstrSessionID = msgResponse.getValue("uinml.header.session");

		if(mstrSessionID == null){
			throw new Exception("Session id not found in response message");
		}
		is = socket.getInputStream();
		mlngNextSendKeepAlive = System.currentTimeMillis() + mintKeepAliveInterval;
	}

	public void disconnect()
	{
		if(socket != null){
			try{
				XMLMessage msgRequest = new XMLMessage();
				msgRequest.setValue("uinml.header.session",mstrSessionID);
				msgRequest.setValue("uinml.header.command",EXIT_COMMAND);
				msgRequest.store(socket.getOutputStream());
				socket.getOutputStream().flush();
				Thread.sleep(5000);
				socket.close();
			}
			catch(Exception e){
				e.printStackTrace();
			}
			socket = null;
		}
	}
}
